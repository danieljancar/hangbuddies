{
    "name": "hangbuddies",
    "version": "1.0.0",
    "description": "HangBuddies is an open-source, monorepo-based web application that enables users to quickly create and share surveys without registration or any other fuss.",
    "scripts": {
        "prepare": "husky",
        "format": "prettier --write .",
        "format:changed": "prettier --write . --list-different",
        "format:check": "prettier --check .",
        "commitlint": "commitlint --edit",
        "lint:frontend": "npm run --prefix apps/frontend lint",
        "lint:backend": "npm run --prefix apps/backend lint",
        "start:frontend": "npm run --prefix apps/frontend start",
        "start:backend": "npm run --prefix apps/backend start"
    },
    "lint-staged": {
        "**/*": "prettier --write --ignore-unknown"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/danieljancar/hangbuddies.git"
    },
    "keywords": [
        "open-source",
        "monorepo",
        "survey-app",
        "quick-poll"
    ],
    "author": "Daniel Jancar",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/danieljancar/hangbuddies/issues"
    },
    "homepage": "https://github.com/danieljancar/hangbuddies#readme",
    "devDependencies": {
        "@commitlint/config-conventional": "^19.8.1",
        "@commitlint/cli": "^19.8.1",
        "husky": "^9.1.7",
        "lint-staged": "^15.5.2",
        "prettier": "3.5.3"
    },
    "engines": {
        "node": ">=20.0.0",
        "npm": ">=10.9.0"
    },
    "dependencies": {
        "dotenv": "^16.5.0"
    }
}
