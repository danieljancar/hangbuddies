# Get staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=d | grep -E '\.(js|ts|tsx|json|md|css|scss|html)$' || true)

if [ -n "$STAGED_FILES" ]; then
  echo "Formatting staged files..."
  echo "$STAGED_FILES" | xargs -r npx prettier --write
  echo "$STAGED_FILES" | xargs -r git add  # Ensure formatted files stay staged
else
  echo "No files to format."
fi

# Get changed files
CHANGED_FILES=$(git diff --cached --name-only || true)

# Check if frontend has changes
if echo "$CHANGED_FILES" | grep -q "apps/frontend/"; then
  if [ -d "apps/frontend" ]; then
    echo "Linting frontend..."
    npm run lint --prefix apps/frontend || true
  fi
fi

# Check if backend has changes
if echo "$CHANGED_FILES" | grep -q "apps/backend/"; then
  if [ -d "apps/backend" ]; then
    echo "Linting backend..."
    npm run lint --prefix apps/backend || true
  fi
fi

# Run lint-staged for additional checks
npx lint-staged
